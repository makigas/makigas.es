<% content_for :title, "#{t('.meta.title')} – makigas" %>
<% content_for :description, t('.meta.description') %>
<% content_for :hero do %>
  <h1><%= t('.title') %></h1>
<% end %>
<%= makigas_wrapper(css_classes: 'topicslist', breath: true) do %>
  <% @topics.each do |tp| %>
    <%= render Six::Explorer::TopicCardComponent.new(topic: tp) %>
  <% end %>
<% end %>
