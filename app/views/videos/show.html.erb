<% content_for :title, "#{@video.title} – #{@video.playlist.title} – makigas" %>
<% content_for :description, @video.description %>
<% content_for(:tags, @video.tags.sort.join(' ')) if @video.tags.present? %>
<% content_for :twitter do %>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@makigas">
  <meta name="twitter:title" content="<%= @video.title %> – <%= @video.playlist.title %>">
  <meta name="twitter:description" content="<%= @video.description %>">
  <meta name="twitter:image" content="<%= image_url(@video.playlist.card.url, only_path: false) %>">
<% end %>
<% content_for :facebook do %>
  <meta property="og:url" content="<%= canonical_url %>">
  <meta property="og:title" content="<%= @video.title %> – <%= @video.playlist.title %>">
  <meta property="og:type" content="website">
  <meta property="og:description" content="<%= @video.description %>">
  <meta property="og:site_name" content="makigas">
  <meta property="og:image" content="<%= image_url(@video.playlist.card.url, only_path: false) %>">
<% end %>
<% content_for :meta do %>
  <%= tag(:meta, name: 'fediverse:creator', content: @video.user.fediverse_creator_id) if @video&.user&.fediverse_creator_id.present? %>
  <%= tag(:link, rel: :alternate, href: playlist_url(@playlist, format: :atom), title: t('.meta.playlist_feed', playlist: @playlist.title), type: 'application/atom+xml') %>
  <% if @video.scheduled? %>
    <meta name="robots" content="noindex">
  <% end %>
<% end %>
<% content_for :jsonld do %>
  <%= Jsonld::VideoBlueprint.render(@video, host: request.host).html_safe %>
<% end %>
<% content_for :body_classes, 'video-player-page' %>
<% if @video.playlist.topic %>
  <% content_for :header do %>
    <style>
      .main-header, .hero-tron { background: <%= @video.playlist.topic.color %>; }
      .main-header .navbar-makigas { background: rgba(0, 0, 0, 0.25); }
    </style>
  <% end %>
<% end %>

<%= makigas_wrapper(breath: true) do %>
<div class="videopage h-entry">
  <article class="videopage__left article">
    <header class="article__header">
      <% if @video.playlist.present? %>
      <p class="article__taxonomy">
        <%= link_to @video.playlist.title, playlist_path(@video.playlist), class: 'article__category' %>
      </p>
      <% end %>
      <h1 class="article__title p-name">
        <%= link_to playlist_video_path(@video, playlist_id: @video.playlist.slug), class: 'article__permalink u-url' do %>
          <%= @video.title %>
        <% end %>
      </h1>
      <p class="article__meta">
        <%= content_tag(:time, l(@video.published_at.to_date, format: :long), datetime: @video.published_at.to_time.iso8601, class: 'dt-published') %> &bull;
        <%= content_tag(:data, t('.duration', duration: running_time(@video.duration)), class: 'p-duration', value: ActiveSupport::Duration.build(@video.duration).iso8601) %>
      </p>
      <p class="article__summary <%= @video.show_note.present? ? 'p-summary' : 'e-content' %>">
        <%= @video.excerpt || @video.description %>
      </p>
    </header>
    <%= render Makigas::Playlist::DeprecatedComponent.new(playlist: @video.playlist) if @video.playlist.deprecated %>
    <% if @video.youtube_id %>
      <%= render Six::Base::YoutubeEmbedComponent.new(youtube_id: @video.youtube_id) %>
    <% end %>
    <% if @video.show_note.present? %>
      <div class="article__content e-content">
        <%= makigas_markdown(text: @video.show_note.content) %>
      </div>
    <% else %>
      <div class="article__placeholder">
        <p>
        <strong>Este vídeo lamentablemente todavía no tiene notas de episodio.</strong>
        Todavía quedan algunos vídeos en este sitio web que no tienen artículos
        de texto por si te gusta más leer que ver vídeos, y parece que esta
        página es una de ellas.
        </p>
        <p class="article__survey">
        <strong>¡Ayúdame a saber qué es prioritario y qué no!</strong>
        ¿Te hubiese ayudado encontrar un artículo de texto en esta página junto al vídeo?
        <button class="btn videoinfo__nonotes__btn" id="notes-survey-yes">Sí</button>
        <button class="btn videoinfo__nonotes__btn" id="notes-survey-no">No</button>
        </p>
      </div>
    <% end %>
    <a class="u-bridgy-fed" href="https://fed.brid.gy/" hidden="from-humans"></a>
  </article>
  <section class="videopage__sidebar">
    <%= render Six::Lesson::QuestionComponent.new(forum: @video.playlist.display_forum_url, utm: forum_utm_params(@video), tags: @video.tags) %>
    <%= render Six::Lesson::TeacherComponent.new(user: @video.user) if @video.user.present? %>
    <%= render(Six::Lesson::PartOfPlaylistComponent.new(video: @video)) if @video.playlist.present? %>
  </section>
  <% end %>
