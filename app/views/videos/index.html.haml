- content_for :title, "#{t('.meta.title')} - makigas"
- content_for :description, t('.meta.description')
- content_for :canonical, videos_url
- content_for :header do
  %meta{name: :robots, content: :noindex}
- content_for(:navbar) do
  = render Six::Layout::NavbarComponent.new(show_search: false)


= render Explorer::SidebarExplorerComponent.new do |explorer|
  - explorer.with_filter(title: 'Ordenar resultados') do |box|
    - box.with_pill(url: derive_search_url(sort: nil), active: params[:sort].blank?) { 'Relevancia' }
    - video_search_sort_criterias.each do |label, criteria|
      - box.with_pill(url: derive_search_url(sort: criteria), active: params[:sort] == criteria).with_content(label)
  - explorer.with_filter(title: 'Filtrar por duración') do |box|
    - box.with_pill(url: derive_search_url(length: nil), active: params[:length].blank?) { 'Cualquier duración' }
    - video_search_duration_filters.each do |label, filter|
      - box.with_pill(url: derive_search_url(length: filter), active: params[:length] == filter).with_content(label)
  - explorer.with_filter(title: 'Filtrar por tema') do |box|
    - box.with_pill(url: derive_search_url(topic: nil), active: params[:topic].blank?) { 'Cualquier tema' }
    - Topic.order(title: :asc).each do |topic|
      - box.with_pill(url: derive_search_url(topic: topic.slug), active: params[:topic].present? && params[:topic] == topic.slug).with_content(topic.title)
  - explorer.with_filter(title: 'Filtrar por etiqueta (BETA)') do |box|
    - box.with_pill(url: derive_search_url(tag: nil), active: params[:tag].blank?) { 'Cualquier etiqueta' }
    - Video.tags.sort.each do |tag|
      - box.with_pill(url: derive_search_url(tag: tag), active: params[:tag] == tag).with_content("##{tag}")
  - explorer.with_main do
    = render Six::Layout::SearchComponent.new(query: params[:q], size: :normal, variant: :light)
    = render Six::Search::CurrentFiltersComponent.new(filters: params)
    - if @matching_tag.present? && (params[:page].nil? || params[:page].to_s == "1")
      = render Six::Search::TagInformationComponent.new(tag: @matching_tag)
      = render Six::Search::RelatedPlaylistsComponent.new(tag: @matching_tag)
    - if @videos.present?
      = render Six::Search::ResultComponent.with_collection(@videos)
      .paginator= paginate @videos
    - else
      = render Six::Search::EmptyComponent.new(filters: params)

