- content_for :title, "#{t('.meta.title')} - makigas"
- content_for :description, t('.meta.description')
- content_for :canonical, videos_url
- content_for :header do
  %meta{name: :robots, content: :noindex}
- content_for(:navbar) do
  = render Six::Layout::NavbarComponent.new(show_search: false)

= makigas_wrapper(breath: true) do
  = makigas_layout(position: :left, responsive_toggle_button_text: "Mostrar opciones") do |layout|
    - layout.with_sidebar do |sidebar|
      - sidebar.with_section(header: 'Ordenar resultados') do |section|
        - section.with_item(href: derive_search_url(sort: 'relevance'), active: @sort == 'relevance').with_content('Relevancia') if params[:q].present?
        - section.with_item(href: derive_search_url(sort: 'recent'), active: @sort == 'recent') { 'Más recientes' }
        - section.with_item(href: derive_search_url(sort: 'popular'), active: @sort == 'popular') { 'Más vistos' }
        - section.with_item(href: derive_search_url(sort: 'trending'), active: @sort == 'trending') { 'En tendencia' }
      - sidebar.with_section(header: 'Filtrar por duración') do |section|
        - section.with_item(href: derive_search_url(length: nil), active: params[:length].blank?) { 'Cualquier duración' }
        - video_search_duration_filters.each do |label, filter|
          - section.with_item(href: derive_search_url(length: filter), active: params[:length] == filter).with_content(label)
      - sidebar.with_section(header: 'Filtrar por tema') do |section|
        - section.with_item(href: derive_search_url(tag: nil), active: params[:tag].blank?) { 'Cualquier tema' }
        - active_tags.each do |tag|
          - section.with_item(href: derive_search_url(tag: tag.slug), active: params[:tag] == tag.slug) { tag.title }

    = render Six::Layout::SearchComponent.new(query: params[:q], size: :normal, variant: :light)
    = render Six::Search::CurrentFiltersComponent.new(filters: params)
    - if @matching_tag.present? && (params[:page].nil? || params[:page].to_s == "1")
      = render Six::Search::TagInformationComponent.new(tag: @matching_tag)
      = render Six::Search::RelatedPlaylistsComponent.new(tag: @matching_tag)
    - if @videos.present?
      = render Six::Search::ResultComponent.with_collection(@videos)
      .paginator= paginate @videos
    - else
      = render Six::Search::EmptyComponent.new(filters: params)

