- content_for :jsonld do
  = Jsonld::PlaylistBlueprint.render(@playlist, host: request.host).html_safe
= makigas_wrapper(css_classes: 'plpagehead', fluid: true) do
  = makigas_wrapper do
    = render Makigas::Playlist::HeaderComponent.new(playlist: @playlist)
= makigas_wrapper(css_classes: 'plpagebody') do
  = render Makigas::Playlist::BodyComponent.new(playlist: @playlist, css_classes: 'plpagebody__content')
  = render Makigas::Playlist::EpisodeListComponent.new(playlist: @playlist, css_classes: 'plpagebody__episodes')
