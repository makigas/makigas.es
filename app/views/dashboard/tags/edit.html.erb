
<% content_for :header do %>
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to t('.dashboard'), :dashboard %></li>
    <li class="breadcrumb-item"><%= link_to t('.tags'), [:dashboard, :tags] %></li>
    <li class="breadcrumb-item"><%= @tag.title %></li>
    <li class="breadcrumb-item current"><%= t('.edit_tag') %></li>
  </ol>
  <h1><%= @tag.title %></h1>
<% end %>
<% content_for :toolbar do %>
  <%= link_to t('.cancel'), [:dashboard, :tags], class: 'btn btn-outline-secondary' %>
<% end %>
<%= render 'form' %>
