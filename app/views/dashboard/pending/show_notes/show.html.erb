<% content_for :header do %>
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to t('.dashboard'), :dashboard %></li>
    <li class="breadcrumb-item"><%= t('.pending') %>
    <li class="breadcrumb-item current"><%= t('.untranscribed') %></li>
  </ol>
  <h1><%= t('.untranscribed') %></h1>
<% end %>

<%= form_with method: :get do |f| %>
  <p>
  <%= f.label :playlist_id, 'Playlist' %>
  <%= f.select :playlist_id, @playlists.pluck(:title, :id), selected: params[:playlist_id], include_blank: '(ninguna)' %>
  </p>
  <p>
  <%= hidden_field_tag :sort, params[:sort] %>
  <%= f.submit 'Apply filters', type: :submit, name: nil, class: 'btn btn-primary btn-sm' %>
  <%= link_to 'Reset', dashboard_pending_show_notes_path, class: 'btn btn-light btn-sm' %>
  </p>
<% end %>

<table class="table">
  <thead>
    <tr>
      <th><%= t('.video') %></th>
      <th><%= render Dashboard::SortableHeaderComponent.new(key: :playlist, label: t('.playlist'), keep: %i(playlist_id), params:) %></th>
      <th><%= render Dashboard::SortableHeaderComponent.new(key: :duration, label: t('.duration'), keep: %i(playlist_id), params:) %></th>
      <th><%= render Dashboard::SortableHeaderComponent.new(key: :publication_date, label: t('.published_at'), keep: %i(playlist_id), params:) %></th>
      <th><%= t('.actions') %></th>
    </tr>
  </thead>
  <tbody>
    <% @videos.each do |video| %>
    <tr>
      <td><%= video.title %></td>
      <td><%= video.playlist.title %></td>
      <td><%= running_time video.duration %></td>
      <td><%= distance_of_time_in_words_to_now video.published_at %></td>
      <td>
        <%= link_to t('.annotate'), dashboard_playlist_video_show_note_path(video_id: video.slug, playlist_id: video.playlist.slug), class: 'btn btn-sm btn-outline-primary' %>
      </td>
    </tr>
    <% end %>
  </tbody>
</table>

<%= paginate @videos %>
