<% content_for :header do %>
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to t('.dashboard'), :dashboard %></li>
    <li class="breadcrumb-item current"><%= t('.videos') %></li>
  </ol>
  <h1><%= t('.videos') %></h1>
<% end %>
<% content_for :toolbar do %>
  <%= link_to t('.new_video'), [:new, :dashboard, :video], class: 'btn btn-success' %>
<% end %>

<%= form_with method: :get do |f| %>
  <p>
  <%= f.label :playlist_id, 'Playlist' %>
  <%= f.select :playlist_id, @playlists.pluck(:title, :id), selected: params[:playlist_id], include_blank: '(ninguna)' %>
  </p>
  <p>
  <%= hidden_field_tag :sort, params[:sort] %>
  <%= f.submit 'Apply filters', type: :submit, name: nil, class: 'btn btn-primary btn-sm' %>
  <%= link_to 'Reset', dashboard_videos_path, class: 'btn btn-light btn-sm' %>
  </p>
<% end %>

<%= render Dashboard::Table::TableComponent.new do |table| %>
  <%= table.with_head do |header| %>
    <%= header.with_heading t('.title'), primary: true %>
    <%= header.with_heading t('.playlist') %>
    <%= header.with_heading do %>
      <%= link_to dashboard_derive_video_list_params(sort: @sorter.flip('released')) do %>
        <%= t('.release_date') %> <%= @sorter.arrow('released') %>
      <% end %>
    <% end %>
    <%= header.with_heading do %>
      <%= link_to dashboard_derive_video_list_params(sort: @sorter.flip('updated')) do %>
        <%= t('.last_update') %> <%= @sorter.arrow('updated') %>
      <% end %>
    <% end %>
    <%= header.with_heading 'Views' %>
    <%= header.with_heading t('.aspect'), html_options: { colspan: 3 } %>
  <% end %>
  <%= table.with_body do |body| %>
    <% @videos.each do |video| %>
      <%= body.with_row do |row| %>
        <%= row.with_primary do |cell| %>
          <%= cell.with_cell do %>
            <%= link_to video.title, [:dashboard, video] %>
          <% end %>
          <%= cell.with_actions do %>
            <%= link_to t('.edit'), [:edit, :dashboard, video], class: 'btn btn-sm btn-link' %> |
            <%= button_to t('.destroy'), [:dashboard, video], method: :delete, class: 'btn btn-sm btn-link text-danger', data: { confirm: t('.really_destroy') } %>
          <% end %>
          <%= cell.with_metadata do |meta| %>
            <%= meta.with_key t('.playlist'), link_to(video.playlist.title, [:dashboard, video.playlist]) %>
            <%= meta.with_key t('.release_date'), l(video.published_at, format: :long) %>
            <%= meta.with_key t('.last_update'), distance_of_time_in_words(video.updated_at, DateTime.now) %>
          <% end %>
        <% end %>
        <%= row.with_cell link_to(video.playlist.title, [:dashboard, video.playlist]) %>
        <%= row.with_cell l(video.published_at, format: :long) %>
        <%= row.with_cell distance_of_time_in_words(video.updated_at, DateTime.now) %>
        <%= row.with_cell do %>
          T <%= video.views_total %><br>R <%= video.views_recent %>
        <% end %>
        <%= row.with_cell do %>
          <% if video.transcription.present? %>
            <span class="bi bi-badge-cc" aria-hidden="true"></span>
            <span class="visually-hidden"><%= t('.with_transcription') %>
          <% end %>
        <% end %>
        <%= row.with_cell do %>
          <% if video.show_note.present? %>
            <span class="bi bi-book" aria-hidden="true"></span>
            <span class="visually-hidden"><%= t('.with_show_notes') %>
          <% end %>
        <% end %>
        <%= row.with_cell do %>
          <% if video.tags.present? %>
            <span class="bi bi-tag" aria-hidden="true"></span>
            <span class="visually-hidden"><%= t('.with_tags') %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<div class="paginator">
  <%= paginate @videos, theme: 'twitter-bootstrap-3' %>
</div>
