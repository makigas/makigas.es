<% content_for :header do %>
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to t('.dashboard'), :dashboard %></li>
    <li class="breadcrumb-item"><%= link_to t('.topics'), [:dashboard, :topics] %></li>
    <li class="breadcrumb-item"><%= link_to @topic.title, [:dashboard, @topic] %></li>
    <li class="breadcrumb-item current"><%= t('.order') %>
  </ol>
  <h1><%= t('.order') %></h1>
<% end %>
<% content_for :toolbar do %>
  <%= link_to t('.back'), [:dashboard, @topic], class: 'btn btn-outline-secondary' %>
<% end %>

<table class="table table-default">
  <thead>
    <tr>
      <th><%= t('.position') %></th>
      <th><%= t('.title') %></th>
      <th><%= t('.actions') %></th>
    </tr>
  </thead>
  <tbody>
    <% @playlists.each do |playlist| %>
    <tr>
      <td><%= playlist.topic_position %></td>
      <td><%= playlist.title %></td>
      <td>
        <%= button_to t('.up'), dashboard_topic_reorder_path(@topic), params: { playlist: playlist.id, direction: 'up' }, remote: true, method: :put, class: 'playlist-move-up btn btn-xs btn-info' %>
          <%= button_to t('.down'), dashboard_topic_reorder_path(@topic), params: { playlist: playlist.id, direction: 'down' }, remote: true, method: :put, class: 'playlist-move-down btn btn-xs btn-info' %>
      </td>
    <% end %>
  </tbody>
</table>
