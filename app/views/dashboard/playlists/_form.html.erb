<%= simple_form_for [:dashboard, @playlist] do |form| %>
  <fieldset>
    <legend><%= t('.information') %></legend>
  <%= form.input :title %>
  <%= form.input :description, as: :text %>
  <%= form.input :excerpt, as: :text %>
  <%= form.input :youtube_id %>
  </fieldset>

  <fieldset>
    <legend><%= t('.metadata') %></legend>
  <%= form.input :forum_url %>
  <p><%= form.input :exclude_from_search %></p>
  <%= form.association :topic, include_blank: :translate %>
  </fieldset>

  <fieldset>
    <legend><%= t('.deprecated') %></legend>
    <%= form.input :deprecated %>
    <%= form.association :replacement_playlist, include_blank: :translate %>
  </fieldset>

  <fieldset>
    <legend><%= t('.icons') %></legend>
  <%= form.input :thumbnail, as: :file %>
  <%= form.input :card, as: :file %>
  </fieldset>


  <%= form.submit class: 'btn btn-success' %>
<% end %>
