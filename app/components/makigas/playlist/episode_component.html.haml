%article.plepisode.h-entry
  = link_to playlist_video_path(@video, playlist_id: @video.playlist.slug), class: 'plepisode__link card u-url' do
    .plepisode__media
      = image_tag("https://i1.ytimg.com/vi/#{@video.youtube_id}/mqdefault.jpg", alt: "", class: 'plepisode__image')
    .plepisode__text
      %h2.plepisode__title.p-name
        = "#{@video.position}. #{@video.title}"
      .plepisode__desc= @video.description
      = render Six::Utils::MetaGroupComponent.new(classes: 'plepisode__metas') do |group|
        - group.with_meta(icon: 'clock') { duration }
