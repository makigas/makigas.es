.searchresult
  %figure.searchresult__media
    = link_to playlist_video_path(video, playlist_id: playlist) do
      %img{src: "https://i1.ytimg.com/vi/#{video.youtube_id}/mqdefault.jpg", alt:""}
    .searchresult__badges
      = render Six::Utils::TrendComponent.new(video:)
  .searchresult__body
    %p.searchresult__title
      = link_to video.title, playlist_video_path(video, playlist_id: playlist)
    %p.searchresult__description= video.description
    - if playlist.present? || topic.present? || video.tags.present?
      = render Six::Utils::MetaGroupComponent.new do |group|
        = render Six::Search::ResultDurationComponent.new(seconds: video.duration)
        = render Six::Search::ResultPlaylistComponent.new(playlist: playlist)
        = render Six::Search::ResultTagsComponent.new(tags: video.tags)
