<aside class="videoauthor p-author h-card">
  <p class="videoauthor__lead"><strong>Tu instructor</strong></p>
  <div class="videoauthor__card">
    <p>
      <%= image_tag user.gravatar_url(size: 128), alt: '', class: 'videoauthor__pic u-photo' %>
    </p>
    <div class="videoauthor__text">
      <p class="videoauthor__name p-name">
        <%= user.name %>
      </p>
      <p class="videoauthor__bio p-note"><%= user.bio %></p>
      <div class="videoauthor__socials">
      <% if user.bluesky_url.present? %>
        <%= link_to user.bluesky_url, title: t('.social.bluesky'), class: 'videoauthor__social videoauthor__social--bluesky', target: :blank do %>
          <svg width="24" height="24" viewBox="0 0 24 24" version="1.1">
