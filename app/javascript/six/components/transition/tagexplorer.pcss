.tagexplorer {
  list-style: none;
  padding-left: 0;
  display: grid;
  gap: 0.5rem;
  justify-content: center;
  grid-template-columns: repeat(2, 112px);

  @media screen and (width >= 480px) {
    grid-template-columns: repeat(4, 112px);
  }

  @media screen and (width >= 1024px) {
    grid-template-columns: repeat(8, 112px);

    &__tag {
      flex: 1;
    }
  }

  &__link {
    font-size: 0.9rem;
    font-weight: bold;
    display: grid;
    grid-auto-flow: row;
    justify-items: center;
    text-align: center;
    gap: 0.5rem;
    text-wrap: balance;
    width: 100%;
    height: 100%;
    padding: 0;
  }

  &__logo {
    margin: 0.5rem;
    max-width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
  }
}
