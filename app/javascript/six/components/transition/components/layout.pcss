@keyframes Layout--fade {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes Layout--slide {
  from {
    left: -20rem;
  }

  to {
    left: 0;
  }
}

.Layout {
  display: grid;
  grid-auto-flow: row;
  gap: 2rem;

  &__backdrop {
    display: none;
    position: absolute;
    background: rgba(0, 0, 0, 0.3);
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
    animation: Layout--fade 0.2s ease-out;
  }

  &__toggle {
    display: grid;
    grid-auto-flow: row;
    margin: 0.5rem;
    margin-bottom: 0;
  }

  &__sidebar {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    width: 16rem;
    bottom: 0;
    background: white;
    padding: 1rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
    animation: Layout--slide 0.2s ease-out;
    overflow-y: auto;
  }

  &__main {
    margin-left: 0.5rem;
    margin-right: 0.5rem;
  }

  &--open &__backdrop {
    display: block;
  }

  &--open &__sidebar {
    display: block;
  }

  @media screen and (width >= 1024px) {
    grid-auto-flow: column;
    grid-template-columns: 16em 1fr;
    &__sidebar {
      display: block;
      position: relative;
      background: transparent;
      box-shadow: none;
      animation: none;
      overflow-y: unset;
      padding: 0;
      font-size: 0.95em;
    }

    &--right {
      grid-template-columns: 1fr 16rem;
    }

    &--right &__sidebar {
      order: 1;
    }

    &__toggle {
      display: none;
    }

    &__main {
      margin-top: 0.5rem;
      margin-left: 0;
      margin-right: 0;
    }

    &--open &__backdrop {
      display: none;
    }
  }
}
