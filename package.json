{
  "name": "makigas",
  "version": "6.1.2",
  "description": "Upstream source code for makigas.es",
  "repository": "https://github.com/makigas/makigas",
  "author": "Dani Rodríguez",
  "license": "GPLv3",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@fontsource/montserrat": "5.3.0",
    "@popperjs/core": "2.11.8",
    "@rails/ujs": "7.1.3-4",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "esbuild": "0.28.2",
    "esbuild-postcss": "0.0.4",
    "eslint-formatter-compact": "9.0.1",
    "klaro": "0.7.21",
    "normalize.css": "8.0.1",
    "postcss": "8.5.26",
    "postcss-advanced-variables": "5.0.0",
    "postcss-color-function": "4.1.0",
    "postcss-import": "17.0.0",
    "postcss-nested": "8.0.1",
    "postcss-scss": "4.0.9",
    "postcss-strip-inline-comments": "0.1.5",
    "string-width": "8.2.2",
    "youtube-player": "5.6.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/rails__ujs": "6.0.4",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "stylelint": "17.14.1",
    "stylelint-config-recommended-scss": "17.0.1",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-prettier": "5.0.3",
    "stylelint-scss": "7.2.0"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:watch": "node esbuild.mjs --watch",
    "clean": "rimraf app/assets/builds/*",
    "fmt:check": "prettier --check app/javascript",
    "fmt": "prettier --write app/javascript",
    "lint": "$npm_execpath run lint:js && $npm_execpath run lint:css",
    "lint:js": "eslint 'app/javascript/**/*.js'",
    "lint:css": "stylelint 'app/javascript/**/*.scss'"
  }
}
