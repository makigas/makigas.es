{
  "name": "makigas",
  "version": "6.1.2",
  "description": "Upstream source code for makigas.es",
  "repository": "https://github.com/makigas/makigas",
  "author": "Dani Rodríguez",
  "license": "GPLv3",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@fontsource/montserrat": "5.3.0",
    "@popperjs/core": "2.11.8",
    "@rails/ujs": "7.1.3-4",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.2",
    "esbuild": "0.28.2",
    "esbuild-postcss": "0.0.4",
    "eslint-formatter-compact": "9.0.1",
    "klaro": "0.7.21",
    "normalize.css": "8.0.1",
    "postcss": "8.5.30",
    "postcss-advanced-variables": "5.0.0",
    "postcss-import": "17.0.1",
    "postcss-nested": "9.0.0",
    "postcss-scss": "4.0.9",
    "string-width": "8.3.0",
    "youtube-player": "5.6.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/rails__ujs": "6.0.4",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "stylelint": "17.16.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-prettier": "5.0.3",
    "stylelint-scss": "7.3.0"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:watch": "node esbuild.mjs --watch",
    "clean": "rimraf app/assets/builds/*",
    "fmt:check": "prettier --check app/javascript",
    "fmt": "prettier --write app/javascript",
    "lint": "$npm_execpath run lint:js && $npm_execpath run lint:css",
    "lint:js": "eslint 'app/javascript/**/*.js'",
    "lint:css": "stylelint 'app/javascript/**/*.scss'"
  }
}
