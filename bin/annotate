#!/usr/bin/env ruby
# frozen_string_literal: true

ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)

require 'rubygems'
require 'bundler/setup'

case ARGV.first
when '--models'
  ARGV[0] = 'models'
when '--routes'
  ARGV[0] = 'routes'
when 'models', 'routes', 'help', 'version', '-h', '--help', '-v', '--version'
  # Pass through AnnotateRb commands and global options.
else
  ARGV.unshift('models')
end

load Gem.bin_path('annotaterb', 'annotaterb')
